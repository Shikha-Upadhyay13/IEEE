{
  "rewrites": [
    {
      "source": "/view/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|spider|facebookexternalhit|WhatsApp|Embedly|SkypeUriPreview|Pinterest|vkShare|Quora Link Preview).*"
        }
      ],
      "destination": "/api/share?id=:id"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
