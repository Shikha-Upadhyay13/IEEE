# Copy to .env and fill in. Every VITE_ value ships to the browser, so never
# put a secret (service-role key, Groq key) here.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend services (see render.yaml)
VITE_PDF_SERVICE_URL=http://localhost:3001
VITE_AI_SERVICE_URL=http://localhost:3002

# Public site origin, used for canonical URLs, sitemap.xml and share previews
VITE_SITE_URL=http://localhost:5173

# Optional monitoring
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
