# Applies repo-wide; app/ also has its own .gitignore for Vite-specific paths.
node_modules

# Generated PDF export output — never a source artifact.
*.pdf

# Service credentials (e.g. ai-service/.env holding GROQ_API_KEY) — never
# committed, same rationale as app/.gitignore's Supabase key exclusion.
.env
.env.*
