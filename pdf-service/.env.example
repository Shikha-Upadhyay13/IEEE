# Frontend that serves /print/:documentId
FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed to call /export
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Same values as app/.env VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY; used to
# reject expired export tokens before launching Chromium
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Render limits
MAX_CONCURRENT_RENDERS=2
MAX_QUEUE_SIZE=10
RENDER_TIMEOUT_MS=45000
# Optional error reporting
# SENTRY_DSN=
